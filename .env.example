SERVICENOW_INSTANCE=https://yourinstance.service-now.com
# basic or oauth. Defaults to oauth when omitted.
SERVICENOW_AUTH_TYPE=oauth
MCP_ENABLED_FEATURES=common,service_desk,product_owner

# Basic mode only:
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# OAuth refresh-token mode (recommended for OAuth):
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
SERVICENOW_OAUTH_REFRESH_TOKEN=
# Optional externally managed token. Refresh token takes precedence when set.
SERVICENOW_OAUTH_ACCESS_TOKEN=
