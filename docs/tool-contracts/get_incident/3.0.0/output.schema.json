      "additionalProperties": false,
      "properties": {
        "table": {
          "const": "incident",
          "description": "Source ServiceNow table.",
          "title": "Table",
          "type": "string"
        },
        "record": {
          "additionalProperties": false,
          "properties": {
            "number": {
              "description": "Incident number used for follow-up.",
              "title": "Number",
              "type": "string"
            },
            "short_description": {
              "description": "ServiceNow field value as a string. Omitted when not returned.",
              "title": "Short Description",
              "type": "string"
            },
            "description": {
              "description": "ServiceNow field value as a string. Omitted when not returned.",
              "title": "Description",
              "type": "string"
            },
            "state": {
              "description": "ServiceNow display label. Omitted when not returned.",
              "title": "State",
              "type": "string"
            },
            "priority": {
              "description": "ServiceNow display label. Omitted when not returned.",
              "title": "Priority",
              "type": "string"
            },
            "assignment_group": {
              "description": "Reference display name. Omitted when not returned.",
              "title": "Assignment Group",
              "type": "string"
            },
            "assigned_to": {
              "description": "Reference display name. Omitted when not returned.",
              "title": "Assigned To",
              "type": "string"
            },
            "caller_id": {
              "description": "Reference display name. Omitted when not returned.",
              "title": "Caller Id",
              "type": "string"
            },
            "active": {
              "description": "ServiceNow field value as a string. Omitted when not returned.",
              "title": "Active",
              "type": "string"
            },
            "sys_created_on": {
              "description": "ServiceNow field value as a string. Omitted when not returned.",
              "title": "Sys Created On",
              "type": "string"
            },
            "sys_updated_on": {
              "description": "ServiceNow field value as a string. Omitted when not returned.",
              "title": "Sys Updated On",
              "type": "string"
            },
            "url": {
              "description": "ServiceNow incident URL filtered by incident number.",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "number",
            "url"
          ],
          "title": "IncidentRecord",
          "type": "object",
          "description": "Approved incident fields; sys_id is omitted."
        },
        "redaction": {
          "additionalProperties": false,
          "properties": {
            "excluded_categories": {
              "const": [
                "journal_history",
                "attachments",
                "non_allowlisted_fields"
              ],
              "description": "Content categories excluded by policy, whether or not present upstream.",
              "items": {
                "enum": [
                  "journal_history",
                  "attachments",
                  "non_allowlisted_fields"
                ],
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "Excluded Categories",
              "type": "array"
            },
            "omitted_fields": {
              "description": "Allowlisted fields absent from the returned record; absence reason is unknown.",
              "items": {
                "enum": [
                  "number",
                  "short_description",
                  "description",
                  "state",
                  "priority",
                  "assignment_group",
                  "assigned_to",
                  "caller_id",
                  "active",
                  "sys_created_on",
                  "sys_updated_on"
                ],
