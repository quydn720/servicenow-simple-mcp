# Separate from the existing local MCP .env. Never use a shared user token here.
# development, test or production. Test and production refuse insecure settings,
# including any secret written in this file (docs/servicenow-access.md).
MCP_ENVIRONMENT=development
MCP_SERVICENOW_INSTANCE=https://yourinstance.service-now.com
MCP_PUBLIC_URL=https://mcp.example.com
MCP_SERVICENOW_CLIENT_ID=
MCP_SERVICENOW_CLIENT_SECRET=
# Generate independent random keys using the commands in docs/remote-server.md.
# Any secret here can instead be read from a file: set <NAME>_FILE to its path.
# MCP_ENCRYPTION_KEY may list several keys, newest first, to rotate without
# signing users out (docs/deployment.md#secrets).
MCP_SIGNING_KEY=
MCP_ENCRYPTION_KEY=
# Exact callbacks from your approved MCP clients, comma-separated. No wildcards.
# Use the client's actual callback; the URL below is illustrative.
MCP_ALLOWED_REDIRECT_URIS=http://127.0.0.1:8766/callback
# Required: the identity API's path on this instance (its Scripted REST API's
# Base API path plus /me, e.g. /api/<namespace>/identity/me).
MCP_IDENTITY_PATH=
MCP_STORAGE_DIR=.mcp-tokens
# Confidential ServiceNow client: authenticate with its secret, without PKCE.
# Enable only if your instance supports PKCE together with confidential clients.
# Client-to-broker PKCE remains mandatory either way.
MCP_FORWARD_PKCE=false
# How long a client sign-in lasts before the user signs in again: 3600-2592000
# seconds (1 hour to 30 days). ServiceNow's Refresh Token Lifespan also applies.
MCP_SESSION_LIFETIME_SECONDS=86400
# Optional OAuth scope to request from ServiceNow, e.g. a dedicated read scope
# limited by REST API auth scopes on the instance (docs/remote-server.md).
MCP_SERVICENOW_SCOPE=
# MCP clients allowed to sign in, by client ID metadata URL (comma-separated).
# Default: Claude only. Unapproved URLs are rejected before being fetched.
MCP_APPROVED_CLIENTS=https://claude.ai/oauth/mcp-oauth-client-metadata
# Re-enable open dynamic client registration at /register (true/false).
MCP_ALLOW_DYNAMIC_REGISTRATION=false
# ServiceNow token revocation endpoint used by /revoke; confirm it on your
# instance. Empty skips the ServiceNow call (the local grant is still deleted).
MCP_SERVICENOW_REVOKE_PATH=/oauth_revoke_token.do
